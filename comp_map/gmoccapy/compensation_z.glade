<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <!-- interface-requires gladevcp 0.0 -->
  <requires lib="gtk+" version="2.24"/>
  <!-- interface-naming-policy project-wide -->
  <object class="GtkAction" id="action1"/>
  <object class="GtkAction" id="action2"/>
  <object class="GtkAdjustment" id="adj_comp">
    <property name="lower">-1</property>
    <property name="upper">1</property>
    <property name="step_increment">0.00050000000000000012</property>
  </object>
  <object class="GtkWindow" id="window1">
    <property name="width_request">190</property>
    <property name="height_request">250</property>
    <property name="can_focus">False</property>
    <property name="resizable">False</property>
    <property name="default_width">186</property>
    <property name="default_height">250</property>
    <property name="accept_focus">False</property>
    <property name="focus_on_map">False</property>
    <property name="deletable">False</property>
    <property name="gravity">north-east</property>
    <property name="mnemonics_visible">False</property>
    <child>
      <object class="GtkFrame" id="compensation">
        <property name="width_request">190</property>
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="label_xalign">0.5</property>
        <child>
          <object class="GtkTable" id="table3">
            <property name="width_request">190</property>
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="n_columns">2</property>
            <child>
              <object class="GtkVBox" id="vbox3">
                <property name="width_request">124</property>
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <child>
                  <object class="GtkHBox" id="hbox2">
                    <property name="visible">True</property>
                    <property name="can_focus">False</property>
                    <child>
                      <object class="GtkLabel" id="realZ1">
                        <property name="width_request">25</property>
                        <property name="visible">True</property>
                        <property name="can_focus">False</property>
                        <property name="label" translatable="yes">Z</property>
                        <attributes>
                          <attribute name="weight" value="bold"/>
                          <attribute name="stretch" value="ultra-condensed"/>
                          <attribute name="gravity" value="west"/>
                          <attribute name="scale" value="1.6000000000000001"/>
                        </attributes>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">False</property>
                        <property name="position">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="HAL_Label" id="realZ">
                        <property name="width_request">100</property>
                        <property name="visible">True</property>
                        <property name="can_focus">False</property>
                        <property name="label" translatable="yes">0</property>
                        <property name="justify">right</property>
                        <property name="label_pin_type">1</property>
                        <property name="text_template">%.3f</property>
                        <attributes>
                          <attribute name="weight" value="bold"/>
                          <attribute name="stretch" value="ultra-condensed"/>
                          <attribute name="gravity" value="east"/>
                          <attribute name="gravity-hint" value="strong"/>
                          <attribute name="foreground" value="#000000000000"/>
                          <attribute name="scale" value="1.6000000000000001"/>
                        </attributes>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">False</property>
                        <property name="position">1</property>
                      </packing>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                    <property name="padding">10</property>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkHBox" id="hbox1">
                    <property name="visible">True</property>
                    <property name="can_focus">False</property>
                    <child>
                      <object class="GtkLabel" id="deltaZ1">
                        <property name="width_request">25</property>
                        <property name="visible">True</property>
                        <property name="can_focus">False</property>
                        <property name="label" translatable="yes">Δ</property>
                        <attributes>
                          <attribute name="weight" value="bold"/>
                          <attribute name="stretch" value="ultra-condensed"/>
                          <attribute name="gravity" value="west"/>
                          <attribute name="scale" value="1.6000000000000001"/>
                        </attributes>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">False</property>
                        <property name="position">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="HAL_Label" id="deltaZ">
                        <property name="width_request">100</property>
                        <property name="visible">True</property>
                        <property name="can_focus">False</property>
                        <property name="label" translatable="yes">0</property>
                        <property name="justify">right</property>
                        <property name="track_visited_links">False</property>
                        <property name="label_pin_type">1</property>
                        <property name="text_template">%.3f</property>
                        <attributes>
                          <attribute name="weight" value="bold"/>
                          <attribute name="stretch" value="ultra-condensed"/>
                          <attribute name="gravity" value="east"/>
                          <attribute name="gravity-hint" value="strong"/>
                          <attribute name="foreground" value="#000000000000"/>
                          <attribute name="scale" value="1.6000000000000001"/>
                        </attributes>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">False</property>
                        <property name="position">1</property>
                      </packing>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                    <property name="position">1</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkHBox" id="hbox4">
                    <property name="visible">True</property>
                    <property name="can_focus">False</property>
                    <property name="homogeneous">True</property>
                    <child>
                      <object class="HAL_LED" id="enable_comp_led">
                        <property name="visible">True</property>
                        <property name="sensitive">False</property>
                        <property name="app_paintable">True</property>
                        <property name="can_focus">False</property>
                        <property name="led_blink_rate">0</property>
                      </object>
                      <packing>
                        <property name="expand">True</property>
                        <property name="fill">True</property>
                        <property name="position">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="HAL_LED" id="error_comp_led">
                        <property name="visible">True</property>
                        <property name="sensitive">False</property>
                        <property name="app_paintable">True</property>
                        <property name="can_focus">False</property>
                        <property name="led_blink_rate">0</property>
                        <property name="off_color">green</property>
                        <property name="on_color">red</property>
                      </object>
                      <packing>
                        <property name="expand">True</property>
                        <property name="fill">True</property>
                        <property name="position">1</property>
                      </packing>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                    <property name="position">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkHBox" id="hbox3">
                    <property name="width_request">120</property>
                    <property name="visible">True</property>
                    <property name="can_focus">False</property>
                    <property name="homogeneous">True</property>
                    <child>
                      <object class="HAL_ToggleButton" id="enable_comp">
                        <property name="label">Enable</property>
                        <property name="width_request">54</property>
                        <property name="height_request">54</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="has_focus">True</property>
                        <property name="receives_default">False</property>
                        <property name="yalign">0.52999997138977051</property>
                        <property name="image_position">top</property>
                        <property name="draw_indicator">True</property>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">False</property>
                        <property name="position">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="HAL_Button" id="reset_comp">
                        <property name="label">Open</property>
                        <property name="width_request">54</property>
                        <property name="height_request">54</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="has_focus">True</property>
                        <property name="receives_default">False</property>
                        <property name="image_position">top</property>
                        <signal name="clicked" handler="comp_reset_click" swapped="no"/>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">False</property>
                        <property name="position">1</property>
                      </packing>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                    <property name="padding">3</property>
                    <property name="position">3</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="x_options">GTK_SHRINK</property>
                <property name="x_padding">5</property>
                <property name="y_padding">2</property>
              </packing>
            </child>
            <child>
              <object class="HAL_VScale" id="adj_comp_scale">
                <property name="width_request">60</property>
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="adjustment">adj_comp</property>
                <property name="inverted">True</property>
                <property name="show_fill_level">True</property>
                <property name="fill_level">60</property>
                <property name="digits">3</property>
                <property name="value_pos">left</property>
              </object>
              <packing>
                <property name="left_attach">1</property>
                <property name="right_attach">2</property>
                <property name="y_padding">3</property>
              </packing>
            </child>
          </object>
        </child>
        <child type="label">
          <object class="GtkLabel" id="label-comp">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="label" translatable="yes">&lt;b&gt;Compensation Z&lt;/b&gt;</property>
            <property name="use_markup">True</property>
            <property name="track_visited_links">False</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
