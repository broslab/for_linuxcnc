############### Setup #############################
# reserve functions or2.0 or2.1 sum2.0 sum2.1
# but if а functions or2 sum2 been used previously, 
# need to adjust the sequence numbers
###################################################
loadrt or2 count=2
loadrt sum2 count=2

addf or2.0 servo-thread
addf or2.1 servo-thread
addf sum2.0 servo-thread
addf sum2.1 servo-thread

net xpos-cmd joint.0.motor-pos-cmd => compensation_z_math.x_map
net ypos-cmd joint.1.motor-pos-cmd => compensation_z_math.y_map

# disable control signals Z axis feedback
# отключить сигналы обратной связи по оси Z
unlinkp stepgen.2.position-cmd
unlinkp joint.2.motor-pos-cmd
unlinkp joint.2.motor-pos-fb

# re-assign the control signals and the feedback
# переназначить управляющие сигналы и обратную связь
net zpos-cmd <= joint.2.motor-pos-cmd
net zpos-cmd => joint.2.motor-pos-fb

# New Z = (Manual compensation Z) + (Auto compensation Z from filename) + (Z abs)
# Новый Z = (Ручная компенсация Z) + (Автоматическая компенсация Z из filename.txt) + (Z abs)
net sum-adj compensation_z.adj_comp_scale => sum2.0.in0
net sum-comp compensation_z_math.out => sum2.0.in1
net zpos-cmd-comp sum2.0.out => sum2.1.in0
net zpos-cmd  => sum2.1.in1
net zpos-cmd-res sum2.1.out => stepgen.2.position-cmd

# show led
# Светодиодная индикация
net comp-enable1 => compensation_z.enable_comp_led
# net comp-reset compensation_z_math.reset => compensation_z.reset_comp_led
net comp-error compensation_z_math.error => compensation_z.error_comp_led

# Set M64 P0 , M65 P0  - digital out №0 (or "Play" button if manually) will ON/OFF Compensation Z from G-code
# Установка M64 P0, M65 P0 - цифрового выхода №0 (или кнопки "Play", если вручную) приведет к включению/выключению компенсации Z с помощью G-кода
net dout-00 <= motion.digital-out-00 
net dout-00 => or2.0.in0
net comp-enable compensation_z.enable_comp => or2.0.in1
net comp-enable1 or2.0.out compensation_z_math.enable  

# это мы настраиваем функцию reset, что бы M64 P1 (цифровой вывод №1) включал reset.
# Set M64 P1 , M65 P1 - digital out №1 (or "Open" button if manually) will  reset(reopen filename) from G-code
# Установка M64 P1, M65 P1 - цифровой выход №1 (или кнопку "Открыть", если вручную) для сброса (повторного открытия filename.txt) с помощью G-кода
net dout-01 <= motion.digital-out-01 
net dout-01 => or2.1.in0
net compensation_z-reset compensation_z.reset_comp => or2.1.in1
net comp-reset or2.1.out compensation_z_math.reset  

# show new Z
# показать новый Z
net zpos-cmd-comp => compensation_z.deltaZ

